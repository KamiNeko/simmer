# Optional first admin account, created only on the very first start while no users exist.
# Leave both empty to create the admin on the setup screen instead. Changing them later
# has no effect; change passwords in the app.
SIMMER_ADMIN_USERNAME=
SIMMER_ADMIN_PASSWORD=

# Long random string that encrypts the AI provider API keys. If left empty, Simmer
# generates one into data/secret.key. Generate one with: openssl rand -hex 32
# Changing it later means re-entering the API keys.
SIMMER_SECRET_KEY=

# Public address of the app. Used in link previews, and an https address turns on
# secure cookies.
SIMMER_BASE_URL=https://recipes.example.com

# Secure cookies only work over HTTPS. Leave unset to follow SIMMER_BASE_URL; set to
# false only to try Simmer over plain http (for example http://<server-ip>:8080).
# SIMMER_COOKIE_SECURE=

# Addresses of the reverse proxy allowed to set X-Forwarded-For/-Proto. "*" trusts
# anyone who can reach port 8080, so set it to your proxy's IP when you can.
FORWARDED_ALLOW_IPS=*
