# Created on first start if no users exist yet. Without these, the app shows a setup screen instead.
SIMMER_ADMIN_USERNAME=admin
SIMMER_ADMIN_PASSWORD=change-this-password

# Long random string, used to sign sessions and (later) encrypt LLM API keys.
# Generate one with: openssl rand -hex 32
SIMMER_SECRET_KEY=

# Public address of the app, used in link previews.
SIMMER_BASE_URL=https://recipes.example.com

# Set to true when the app is served over HTTPS (behind your reverse proxy).
SIMMER_COOKIE_SECURE=true
